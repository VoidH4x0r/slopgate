{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/VoidH4x0r/slopgate/main/schema/slopgate.schema.json",
  "title": "slopgate configuration",
  "description": "Configuration for .slopgate.json / slopgate.config.json.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional JSON Schema reference; accepted and ignored by the CLI."
    },
    "include": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Glob patterns to include; replaces the default pattern set."
    },
    "exclude": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Glob patterns to exclude."
    },
    "ignoreModules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Import names to always treat as declared."
    },
    "rules": {
      "type": "object",
      "description": "Per-rule severity overrides.",
      "propertyNames": {
        "enum": [
          "py/phantom-import",
          "py/noop-test",
          "py/tautological-assert",
          "py/stub-body",
          "py/swallowed-exception",
          "py/dead-branch",
          "py/unreachable",
          "ts/phantom-import",
          "ts/noop-test",
          "ts/tautological-assert",
          "ts/stub-function",
          "ts/swallowed-exception",
          "ts/dead-branch",
          "ts/unreachable",
          "go/phantom-import",
          "go/noop-test",
          "go/unreachable",
          "go/stub-body",
          "go/swallowed-error",
          "rs/phantom-import",
          "rs/noop-test",
          "rs/unreachable",
          "rs/stub-body",
          "rs/swallowed-error",
          "py/duplicate-block",
          "ts/duplicate-block",
          "go/duplicate-block",
          "rs/duplicate-block",
          "py/semantic-duplicate",
          "ts/semantic-duplicate",
          "go/semantic-duplicate",
          "rs/semantic-duplicate"
        ]
      },
      "additionalProperties": {
        "enum": [
          "off",
          "error",
          "warning",
          "info"
        ]
      }
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "description": "Minimum confidence to display."
    },
    "failOn": {
      "enum": [
        "high",
        "medium",
        "low",
        "none"
      ],
      "description": "Minimum confidence that fails the run."
    }
  }
}
