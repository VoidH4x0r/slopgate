{
  "name": "@voidh4x0r/slopgate",
  "version": "0.1.18",
  "description": "The slop gate for AI-written code. Precision-first structural linting for Python and TypeScript.",
  "type": "module",
  "license": "MIT",
  "author": "slopgate contributors",
  "homepage": "https://github.com/VoidH4x0r/slopgate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VoidH4x0r/slopgate.git"
  },
  "bugs": {
    "url": "https://github.com/VoidH4x0r/slopgate/issues"
  },
  "bin": {
    "slopgate": "dist/cli.js"
  },
  "files": [
    "dist",
    "grammars",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:sandbox": "node --test --test-isolation=none \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "bench": "node scripts/benchmark.mjs",
    "demo:gif": "node scripts/make-demo-gif.mjs",
    "set-repo": "node scripts/set-repo.mjs",
    "verify": "npm run typecheck && node scripts/check-links.mjs && npm run test:sandbox && npm run build && node dist/cli.js . --fail-on high && npm pack --dry-run",
    "prepublishOnly": "npm run build && npm run typecheck"
  },
  "dependencies": {
    "web-tree-sitter": "^0.25.10"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "linter",
    "ai-generated-code",
    "static-analysis",
    "code-quality",
    "tree-sitter",
    "cli",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "python",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  }
}
