{
  "name": "@voidh4x0r/slopgate",
  "version": "1.0.0",
  "description": "The slop gate for AI-written code. Precision-first structural linting for Python, TypeScript, Go and Rust.",
  "type": "module",
  "license": "MIT",
  "author": "slopgate contributors",
  "homepage": "https://github.com/VoidH4x0r/slopgate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VoidH4x0r/slopgate.git"
  },
  "bugs": {
    "url": "https://github.com/VoidH4x0r/slopgate/issues"
  },
  "bin": {
    "slopgate": "dist/cli.js"
  },
  "files": [
    "dist",
    "grammars",
    "schema",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:sandbox": "node --import ./test/sandbox-env.mjs --test --test-isolation=none \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "bench": "node scripts/benchmark.mjs",
    "demo:gif": "node scripts/make-demo-gif.mjs",
    "set-repo": "node scripts/set-repo.mjs",
    "verify": "npm run typecheck && npm run check:encoding && npm run check:performance && node scripts/check-links.mjs && npm run test:sandbox && npm run build && node dist/cli.js . --fail-on high && npm pack --dry-run",
    "prepublishOnly": "npm run build && npm run typecheck",
    "check:encoding": "node scripts/check-encoding.mjs",
    "prepack": "npm run build",
    "check:performance": "node scripts/check-performance.mjs",
    "release:check": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "@types/emscripten": "^1.41.6",
    "web-tree-sitter": "^0.25.10"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "linter",
    "ai-generated-code",
    "static-analysis",
    "code-quality",
    "tree-sitter",
    "cli",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "python",
    "typescript",
    "go",
    "rust"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./schema/slopgate.schema.json": "./schema/slopgate.schema.json",
    "./schema/scan-output.schema.json": "./schema/scan-output.schema.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
